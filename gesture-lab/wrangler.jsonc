// The lab as a Cloudflare Worker: the built pages plus /relay/<room>
// (worker/index.js: shared sessions, the phone remote). The public demo runs
// from this config. The relay has no auth of its own: rooms are random names,
// capped at 8 people, and nothing is stored.
// Deploy: npm run build -w cortex-gesture-lab, then bunx wrangler deploy here.
{
  "name": "cortex-gesture",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  // SQLite-backed (works on the free plan); hibernating WebSockets, nothing stored
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
